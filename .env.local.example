# Copy this file to .env.local and fill in values from your Supabase project
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional but recommended: Gemini API key for AI-powered deadline extraction.
# Get one free at https://aistudio.google.com/app/apikey
# Server-side only — do NOT add NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Optional: override the default model. Defaults to gemini-3.1-flash-lite.
# GEMINI_MODEL=gemini-3.1-flash-lite

# Faster extraction: Gemini 2.5 can spend extra time in an internal "thinking"
# step. Default is thinkingBudget=0 (fastest). Use "omit" for model defaults,
# or e.g. 4096 for harder syllabi at the cost of latency.
# GEMINI_THINKING_BUDGET=0

# Max characters of syllabus text sent to Gemini (after whitespace cleanup).
# Lower = faster/cheaper; default 48000. Hard cap 120000.
# GEMINI_MAX_SYLLABUS_CHARS=48000

# ----------------------------------------------------------------------------
# Google Calendar bidirectional sync
# ----------------------------------------------------------------------------
# These are the SAME OAuth client credentials you already pasted into Supabase
# Authentication → Providers → Google. The server uses them to refresh
# Calendar API access tokens with the offline refresh token issued at sign-in.
#
# Make sure your Google Cloud Console OAuth client has BOTH redirect URIs:
#   https://<your-project>.supabase.co/auth/v1/callback   (Supabase)
#   http://localhost:3000/auth/callback                   (this app)
#
# And in the Google Cloud Console "OAuth consent screen → Scopes" allow
# .../auth/calendar (the panel handles the consent prompt for you).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
